# Foundry project and deployed chat model
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<deployed-model-name>
TOOLBOX_NAME=fiber-operations-tools

# Content Understanding resource and analyzer
CONTENT_UNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/
CONTENT_UNDERSTANDING_ANALYZER_ID=<analyzer-id>
CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview
# Optional; otherwise DefaultAzureCredential is used.
# CONTENT_UNDERSTANDING_API_KEY=

# Authenticate locally with DefaultAzureCredential (for example, `az login`).
